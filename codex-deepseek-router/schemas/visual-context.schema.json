{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/codex-deepseek-router/codex-deepseek-router/schemas/visual-context.schema.json",
  "title": "VisualContextPacket",
  "description": "Parent-authored text facts about a visual input. The original visual source is never sent to DeepSeek.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_type", "user_goal", "source_visibility"],
  "properties": {
    "schema": {
      "const": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "user_goal": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visible_text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_visibility": {
      "const": "parent_only"
    }
  }
}
