{
  "description": "Plaintext task handoff for DeepSeek child agents.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(deepseek_flash|deepseek_pro)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/ABSOLUTE/PATH/TO/codex-deepseek-router/plaintext_handoff.py\" --mode hook --state-directory \"/ABSOLUTE/PATH/TO/codex-home/deepseek-router/handoff\"",
            "timeout": 10,
            "statusMessage": "Delivering DeepSeek child assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
